(set-logic QF_NRA_ODE)
(declare-fun x () Real [-100, 100])
(declare-fun v () Real [-100, 100])
(declare-fun x_0 () Real [0, 0])
(declare-fun v_0 () Real [0.5, 1.5])
(declare-fun x_t () Real [-100, 100])
(declare-fun v_t () Real [-100, 100])
(declare-fun time () Real [0, 0.5])
(define-ode flow_1 ((= d/dt[x] v) (= d/dt[v] -1.0)))
(assert (= [x_t v_t] (integral 0. time [x_0 v_0] flow_1)))
(assert (>= x_t 0.6))
(check-sat)
