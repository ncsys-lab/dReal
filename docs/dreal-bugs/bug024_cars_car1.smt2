(set-logic QF_NRA_ODE)
(declare-fun v () Real [-1000000, 1000000])
(declare-fun y () Real [-1000000, 1000000])
(declare-fun a () Real [-1000000, 1000000])
(declare-fun b () Real [-1000000, 1000000])
(declare-fun v_0 () Real [0, 0])
(declare-fun y_0 () Real [0, 0])
(declare-fun a_0 () Real [0, 1])
(declare-fun b_0 () Real [0, 1])
(declare-fun v_t () Real [-1000000, 1000000])
(declare-fun y_t () Real [-1000000, 1000000])
(declare-fun a_t () Real [-1000000, 1000000])
(declare-fun b_t () Real [-1000000, 1000000])
(declare-fun time () Real [5, 5])
(define-ode flow_1 ((= d/dt[v] (- (- a) (* b v))) (= d/dt[y] v) (= d/dt[a] 0.0) (= d/dt[b] 0.0)))
(assert (= [v_t y_t a_t b_t] (integral 0. time [v_0 y_0 a_0 b_0] flow_1)))
(assert (>= y_t 2.5))
(check-sat)
